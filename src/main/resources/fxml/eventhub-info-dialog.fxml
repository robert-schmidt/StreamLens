<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<DialogPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.streamlens.controller.EventHubInfoDialogController"
            prefWidth="600" prefHeight="450">

    <headerText>Event Hub Information</headerText>

    <content>
        <TabPane tabClosingPolicy="UNAVAILABLE">
            <!-- Overview Tab -->
            <Tab text="Overview">
                <VBox spacing="15">
                    <padding>
                        <Insets top="15" right="15" bottom="15" left="15"/>
                    </padding>

                    <GridPane hgap="10" vgap="8">
                        <Label text="Event Hub:" GridPane.columnIndex="0" GridPane.rowIndex="0" styleClass="info-label-bold"/>
                        <Label fx:id="eventHubNameLabel" GridPane.columnIndex="1" GridPane.rowIndex="0"/>

                        <Label text="Namespace:" GridPane.columnIndex="0" GridPane.rowIndex="1" styleClass="info-label-bold"/>
                        <Label fx:id="namespaceLabel" GridPane.columnIndex="1" GridPane.rowIndex="1"/>

                        <Label text="Partitions:" GridPane.columnIndex="0" GridPane.rowIndex="2" styleClass="info-label-bold"/>
                        <Label fx:id="partitionCountLabel" GridPane.columnIndex="1" GridPane.rowIndex="2"/>

                        <Label text="Total Messages:" GridPane.columnIndex="0" GridPane.rowIndex="3" styleClass="info-label-bold"/>
                        <Label fx:id="totalMessagesLabel" GridPane.columnIndex="1" GridPane.rowIndex="3"/>

                        <Label text="Consumer Group:" GridPane.columnIndex="0" GridPane.rowIndex="4" styleClass="info-label-bold"/>
                        <Label fx:id="consumerGroupLabel" GridPane.columnIndex="1" GridPane.rowIndex="4"/>
                    </GridPane>

                    <Separator/>

                    <Label text="Partition Details" styleClass="section-header"/>
                    <TableView fx:id="partitionTable" VBox.vgrow="ALWAYS" prefHeight="200">
                        <columns>
                            <TableColumn fx:id="partitionIdCol" text="Partition" prefWidth="70"/>
                            <TableColumn fx:id="beginSeqCol" text="Begin Seq#" prefWidth="90"/>
                            <TableColumn fx:id="lastSeqCol" text="Last Seq#" prefWidth="90"/>
                            <TableColumn fx:id="lastOffsetCol" text="Last Offset" prefWidth="100"/>
                            <TableColumn fx:id="lastTimeCol" text="Last Enqueued" prefWidth="150"/>
                            <TableColumn fx:id="messageCountCol" text="Messages" prefWidth="80"/>
                        </columns>
                    </TableView>
                </VBox>
            </Tab>

            <!-- Consumer Groups Tab -->
            <Tab text="Consumer Groups">
                <VBox spacing="15">
                    <padding>
                        <Insets top="15" right="15" bottom="15" left="15"/>
                    </padding>

                    <Label text="Current Consumer Group" styleClass="section-header"/>
                    <HBox spacing="10" alignment="CENTER_LEFT">
                        <Label text="Group ID:" prefWidth="80"/>
                        <TextField fx:id="currentGroupField" editable="false" HBox.hgrow="ALWAYS"/>
                    </HBox>

                    <Separator/>

                    <VBox spacing="10" styleClass="info-box">
                        <padding>
                            <Insets top="10" right="10" bottom="10" left="10"/>
                        </padding>
                        <Label text="Consumer Group Management" styleClass="section-header"/>
                        <Label wrapText="true" styleClass="hint-label"
                               text="Azure Event Hubs consumer groups must be managed through the Azure Portal, Azure CLI, or ARM templates. The consumer group used for this connection can be changed in the connection settings."/>
                        <Label wrapText="true" styleClass="hint-label"
                               text="Checkpoints (equivalent to Kafka offsets) are stored externally, typically in Azure Blob Storage when using EventProcessorClient."/>
                        <HBox spacing="10">
                            <Button fx:id="openAzurePortalButton" text="Open Azure Portal" onAction="#handleOpenAzurePortal"/>
                            <Button fx:id="editConnectionButton" text="Edit Connection Settings" onAction="#handleEditConnection"/>
                        </HBox>
                    </VBox>

                    <Pane VBox.vgrow="ALWAYS"/>

                    <HBox spacing="10" alignment="CENTER_LEFT">
                        <Button fx:id="refreshButton" text="Refresh" onAction="#handleRefresh"/>
                    </HBox>
                </VBox>
            </Tab>
        </TabPane>
    </content>

    <buttonTypes>
        <ButtonType fx:constant="CLOSE"/>
    </buttonTypes>
</DialogPane>
