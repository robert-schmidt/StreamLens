<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<DialogPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.streamlens.controller.SettingsController"
            prefWidth="500" minHeight="400" maxHeight="600">

    <headerText>Settings</headerText>

    <content>
        <ScrollPane fitToWidth="true" fitToHeight="true" hbarPolicy="NEVER" vbarPolicy="AS_NEEDED">
            <VBox spacing="15">
                <padding>
                    <Insets top="10" right="15" bottom="10" left="10"/>
                </padding>

                <!-- Local API Settings -->
                <TitledPane text="Local API" expanded="true">
                    <VBox spacing="10">
                        <padding>
                            <Insets top="10" right="10" bottom="10" left="10"/>
                        </padding>
                        <HBox spacing="10" alignment="CENTER_LEFT">
                            <CheckBox fx:id="apiEnabledCheckBox" text="Enable local API server"/>
                        </HBox>
                        <HBox spacing="10" alignment="CENTER_LEFT">
                            <Label text="Port:" prefWidth="80"/>
                            <TextField fx:id="apiPortField" promptText="9876" prefWidth="100"/>
                            <Label text="(default: 9876)" styleClass="hint-label"/>
                        </HBox>
                        <Label text="When enabled, messages are available via REST and WebSocket endpoints."
                               wrapText="true" styleClass="hint-label" maxWidth="400"/>
                    </VBox>
                </TitledPane>

                <!-- Display Settings -->
                <TitledPane text="Display" expanded="false">
                    <VBox spacing="10">
                        <padding>
                            <Insets top="10" right="10" bottom="10" left="10"/>
                        </padding>
                        <HBox spacing="10" alignment="CENTER_LEFT">
                            <Label text="Max messages in view:" prefWidth="150"/>
                            <TextField fx:id="maxMessagesField" promptText="10000" prefWidth="100"/>
                        </HBox>
                        <HBox spacing="10" alignment="CENTER_LEFT">
                            <Label text="Timestamp format:" prefWidth="150"/>
                            <ComboBox fx:id="timestampFormatComboBox" prefWidth="200"/>
                        </HBox>
                    </VBox>
                </TitledPane>

                <!-- Data Settings -->
                <TitledPane text="Data" expanded="false">
                    <VBox spacing="10">
                        <padding>
                            <Insets top="10" right="10" bottom="10" left="10"/>
                        </padding>
                        <HBox spacing="10" alignment="CENTER_LEFT">
                            <Label text="Database:" prefWidth="80"/>
                            <TextField fx:id="databasePathField" editable="false" HBox.hgrow="ALWAYS"/>
                        </HBox>
                        <HBox spacing="10" alignment="CENTER_LEFT">
                            <Button fx:id="clearSavedMessagesButton" text="Clear Saved Messages"
                                    onAction="#handleClearSavedMessages"/>
                            <Label fx:id="savedMessagesCountLabel" text="(0 messages)" styleClass="hint-label"/>
                        </HBox>
                    </VBox>
                </TitledPane>

            </VBox>
        </ScrollPane>
    </content>

    <buttonTypes>
        <ButtonType fx:constant="OK"/>
        <ButtonType fx:constant="CANCEL"/>
    </buttonTypes>
</DialogPane>
